# Discord bot token（Developer Portal → Bot → Reset Token）
DISCORD_TOKEN=
# DeepSeek API key
DEEPSEEK_API_KEY=
# 逗號分隔，只在這些伺服器運作
ALLOWED_GUILD_IDS=
# 可以用管理指令的人（逗號分隔的使用者 ID）
ADMIN_USER_IDS=
# 訊息中出現這些名字也會觸發（逗號分隔）
BOT_NAMES=大小姐
MODEL_DEFAULT=deepseek-v4-flash
MODEL_DEEP=deepseek-v4-pro
# 每個頻道保留的近期訊息數
HISTORY_MAX_MESSAGES=30
# 每日 token 上限，超過就只回固定訊息
DAILY_TOKEN_BUDGET=2000000
USER_COOLDOWN_SECONDS=5
MAX_REPLY_TOKENS=600
# 主動插話機率（0～1），預設關閉
RANDOM_INTERJECT_RATE=0

# ---- 選填 ----
# PERSONA_PATH=persona.md
# DB_PATH=data/bot.sqlite3
# 計算「今日」用量的時區
# BOT_TIMEZONE=Asia/Taipei
# LOG_LEVEL=INFO
# 覆寫價目表（USD / 百萬 tokens）：model:快取命中:未命中:輸出;...
# PRICE_TABLE=deepseek-v4-flash:0.028:0.28:0.42;deepseek-v4-pro:0.145:1.74:3.48

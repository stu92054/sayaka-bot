# Discord bot token（Developer Portal → Bot → Reset Token）
DISCORD_TOKEN=
# DeepSeek API key
DEEPSEEK_API_KEY=
# 逗號分隔，只在這些伺服器運作
ALLOWED_GUILD_IDS=
# 可以用管理指令的人（逗號分隔的使用者 ID）
ADMIN_USER_IDS=
# 名字觸發（逗號分隔）；留空 = 不使用名字觸發，只靠 @mention、回覆 bot 和私訊
# 在粉絲群組中不建議用角色名觸發，可以設一個大家不會順口提到的專屬暱稱
BOT_NAMES=
# 對話歷史與摘要中 bot 的名字
BOT_DISPLAY_NAME=沙耶香
# 她的其他名字（中日文、羅馬拼音），逗號分隔。成員把暱稱取成這些名字（含「サヤカ」「さやかさん」「SAYAKA」等寫法）時，
# 對話紀錄裡會標成「（成員暱稱）」，避免被當成她本人說的話。只用於辨識冒充，不會觸發回覆
BOT_ALIASES=沙耶香,さやか,村野沙耶香,村野さやか,Sayaka,Murano Sayaka,Sayaka Murano
# 官方建議用 deepseek-flash（舊名 deepseek-v4-flash 仍可呼叫，同樣以 Flash 計價）
MODEL_DEFAULT=deepseek-flash
# /deep 用的模型；預設和一般聊天同一個（/deep 仍會開思考模式）。想要更強可改 deepseek-v4-pro（費用約 3～7 倍，而且不能看圖）
MODEL_DEEP=deepseek-flash
# 看圖：觸發她的那則訊息附的圖片會送給模型（只有 deepseek-flash 支援）
VISION_ENABLED=true
# low = 縮到 512×512（便宜、快）；high / original = 保留原圖
VISION_DETAIL=low
VISION_MAX_IMAGES=4
VISION_MAX_MB=8
# 每個頻道保留的近期訊息數
HISTORY_MAX_MESSAGES=30
# 在最後一則訊息前附上現在時間（BOT_TIMEZONE），讓她知道現在幾點、星期幾
SHOW_CURRENT_TIME=true
# 對話紀錄的每行使用者訊息加上發言時間，讓她分得出「剛剛」和「昨天」
HISTORY_TIMESTAMPS=true
# 計價幣別，依 DeepSeek 帳戶設定：USD（英文版價目表）或 CNY（中文版價目表）
PRICE_CURRENCY=USD
# 每日費用上限（幣別同 PRICE_CURRENCY，依每次呼叫記錄的費用加總），超過就只回固定訊息；0 = 不限制
DAILY_COST_BUDGET=1
# 每日 token 上限（輸入＋輸出，命中快取的也算），選填；0 = 不限制
# 原作資料每次約多 1 萬 tokens（幾乎都命中快取、很便宜），建議用費用上限控管
DAILY_TOKEN_BUDGET=0
USER_COOLDOWN_SECONDS=5
MAX_REPLY_TOKENS=600
# 主動插話（預設關閉）：一般訊息進入插話判斷的機率（0～1）；建議從 0.03 開始
RANDOM_INTERJECT_RATE=0
# 聊到這些話題時，改用 INTERJECT_KEYWORD_RATE（逗號分隔）
# INTERJECT_KEYWORDS=便當,花式滑冰,滑冰,熬夜,DOLLCHESTRA,小熊貓,金澤
# INTERJECT_KEYWORD_RATE=0.3
# 判斷模型認為「現在插話自然」的機率要超過這個門檻才插話（0～1）
# INTERJECT_THRESHOLD=0.7
# 同一頻道在她上次發言後幾分鐘內不插話
# INTERJECT_CHANNEL_COOLDOWN_MINUTES=10
# 每個頻道每小時最多插話幾次；0 = 不限制
# INTERJECT_MAX_PER_HOUR=3

# 查資料工具（DeepSeek Search／Fetch API，按次計費，算進每日預算），預設關閉
WEB_TOOLS_ENABLED=false
# 一次回覆最多呼叫幾次工具；每人每天最多查幾次（0 = 不限制）
# WEB_MAX_TOOL_CALLS_PER_REPLY=3
# WEB_DAILY_LIMIT_PER_USER=20
# 每次搜尋取幾筆結果（1～50）；讀取網頁時最多給模型看幾個字；單次請求逾時秒數
# WEB_SEARCH_RESULTS=5
# WEB_FETCH_MAX_CHARS=4000
# WEB_TIMEOUT_SECONDS=20

# ---- 選填 ----
# 思考模式：enabled / disabled / omit（omit = 不送參數，用模型預設，目前預設是開啟）
# THINKING_DEFAULT=disabled
# THINKING_DEEP=enabled
# 思考強度（只在思考模式開啟時送出）：low / high / max / omit（omit = 不送，模型預設 high）
# REASONING_EFFORT_DEFAULT=low
# REASONING_EFFORT_DEEP=high
# /deep 的 max_tokens（推理內容也算在 completion 內，會佔用這個上限）
# DEEP_MAX_TOKENS=8000
# PERSONA_PATH=persona.md
# 固定訊息與 slash command 說明
# REPLIES_PATH=replies.toml
# 原作資料資料夾（裡面的 *.md 會整份放進 prompt 最前面）；none = 不使用
# LORE_DIR=lore
# 回憶卡資料夾（recall 工具檢索用，不整份放進 prompt）；none = 不使用。RECALL_RESULTS = 每次回傳幾張（1～10）
# MEMORIES_DIR=memories
# RECALL_RESULTS=3
# DB_PATH=data/bot.sqlite3
# 計算「今日」用量，以及現在時間、發言時間所用的時區
# BOT_TIMEZONE=Asia/Taipei
# LOG_LEVEL=INFO
# 覆寫價格（高峰時段，每百萬 tokens，幣別同 PRICE_CURRENCY）：model:快取命中:未命中:輸出;...
# PRICE_TABLE=deepseek-flash:0.006:0.3:1.2;deepseek-v4-pro:0.044:1.32:3.96
# 空閒時段價格 = 高峰價格 × 此比例
# PRICE_OFFPEAK_RATIO=0.5
# 節假日資料來源（預設自動從 NateScarlet/holiday-cn 下載並快取在 data/holidays/）
# 多個來源用逗號分隔、依序嘗試，{year} 會換成年份；設 none 停用自動下載
# HOLIDAY_SOURCE_URLS=https://raw.githubusercontent.com/NateScarlet/holiday-cn/master/{year}.json,https://cdn.jsdelivr.net/gh/NateScarlet/holiday-cn@master/{year}.json
# 調休補班的週末是否算高峰（DeepSeek 原文為「週末全天空閒」，預設 false）
# HOLIDAY_MAKEUP_WORKDAY_PEAK=false
# 額外手動指定的節假日（整天算空閒時段），逗號分隔 YYYY-MM-DD
# CN_HOLIDAYS=2026-10-01,2026-10-02

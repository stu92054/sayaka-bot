# systemd 範例：複製到 /etc/systemd/system/sayaka-bot.service
# 假設專案放在 /opt/sayaka-bot，並已建立 .venv 與 .env
[Unit]
Description=Murano Sayaka persona Discord bot (DeepSeek)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
Group=botuser
WorkingDirectory=/opt/sayaka-bot
EnvironmentFile=/opt/sayaka-bot/.env
ExecStart=/opt/sayaka-bot/.venv/bin/python -m bot.main
Restart=on-failure
RestartSec=10
# 基本加固
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/sayaka-bot/data

[Install]
WantedBy=multi-user.target
